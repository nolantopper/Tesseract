{
  "name": "tesseract",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local artifact viewer and MCP App for Codex",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && vite build --mode embedded && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "samples": "tsx scripts/samples.ts",
    "release": "npm run build && node scripts/package-release.mjs",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore .",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@foxglove/rosbag": "^0.4.2",
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg-serialization": "^2.1.3",
    "@mcap/core": "^2.4.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "h5wasm": "^0.10.3",
    "laz-perf": "^0.0.7",
    "netcdfjs": "^4.0.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
