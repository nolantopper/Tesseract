{
  "name": "tesseract",
  "version": "0.7.28",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local artifact viewer and MCP App for Codex",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "samples": "tsx scripts/samples.ts",
    "release": "npm run build && node scripts/package-release.mjs",
    "format": "prettier --write --ignore-path .gitignore .",
    "format:check": "prettier --check --ignore-path .gitignore .",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@foxglove/rosbag": "^0.4.2",
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg-serialization": "^2.1.3",
    "@huggingface/gguf": "0.4.6",
    "@mcap/core": "^2.4.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tmcw/togeojson": "7.1.4",
    "@xmldom/xmldom": "0.9.12",
    "ag-psd": "34.2.2",
    "buffer": "6.0.3",
    "dicom-parser": "1.8.21",
    "dxf-parser": "1.1.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "geotiff": "3.0.5",
    "h5wasm": "^0.10.3",
    "hyparquet": "1.33.1",
    "hyparquet-compressors": "1.1.3",
    "laz-perf": "^0.0.7",
    "libarchive.js": "2.0.2",
    "mediabunny": "1.66.2",
    "netcdfjs": "^4.0.0",
    "nifti-reader-js": "0.8.1",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "seek-bzip": "2.0.0",
    "shpjs": "6.2.0",
    "sql.js": "1.17.0",
    "three": "^0.183.0",
    "web-ifc": "0.0.80",
    "xz-decompress": "0.2.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/shpjs": "3.4.7",
    "@types/sql.js": "1.16.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
