#usda 1.0
(
    defaultPrim = "Workcell"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "Workcell"
{
    def Cube "Left_station"
    {
        double size = 1.2
        double3 xformOp:translate = (-1.5, 0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.12, 0.35, 0.65)]
    }
    def Cube "Right_station"
    {
        double size = 1.2
        double3 xformOp:translate = (1.5, 0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.65, 0.3, 0.12)]
    }
    def Sphere "Workpiece"
    {
        double radius = 0.4
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.5, 0.55, 0.6)]
    }
}
