<?xml version="1.0"?>
<robot name="inspection_arm">
  <material name="blue"><color rgba="0.15 0.4 0.7 1"/></material>
  <material name="orange"><color rgba="0.85 0.5 0.2 1"/></material>
  <link name="base">
    <visual name="base_plate"><geometry><box size="1 0.8 0.2"/></geometry><material name="blue"/></visual>
  </link>
  <link name="column">
    <visual name="column_body"><origin xyz="0 0 0.6"/><geometry><cylinder radius="0.16" length="1.2"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base"/><child link="column"/><origin xyz="0 0 0.1"/></joint>
  <link name="tool">
    <visual name="tool_mesh"><origin xyz="0.45 0 0"/><geometry><mesh filename="meshes/tool.obj" scale="0.8 0.2 0.2"/></geometry><material name="orange"/></visual>
  </link>
  <joint name="shoulder" type="revolute"><parent link="column"/><child link="tool"/><origin xyz="0 0 1.2"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="10" velocity="1"/></joint>
</robot>
